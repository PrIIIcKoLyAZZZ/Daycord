<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Shared 24x24 sidebar icon geometries. -->

    <StreamGeometry x:Key="SidebarHomeIcon">
        M3.5 10 L12 3 L20.5 10
        M5.5 9 L5.5 20.5 L18.5 20.5 L18.5 9
        M9.5 20.5 L9.5 14 L14.5 14 L14.5 20.5
    </StreamGeometry>

    <StreamGeometry x:Key="SidebarCalendarIcon">
        M5 5 H19 A2 2 0 0 1 21 7
        V19 A2 2 0 0 1 19 21
        H5 A2 2 0 0 1 3 19
        V7 A2 2 0 0 1 5 5 Z
        M7.5 3 V7
        M16.5 3 V7
        M3 10.5 H21
        M8 15 H10
        M14 15 H16
    </StreamGeometry>

    <StreamGeometry x:Key="SidebarTasksIcon">
        M9 6 H21
        M9 12 H21
        M9 18 H21
        M3 6 L4.5 7.5 L7 4.5
        M3 12 L4.5 13.5 L7 10.5
        M3 18 L4.5 19.5 L7 16.5
    </StreamGeometry>

    <StreamGeometry x:Key="SidebarQuickTaskIcon">
        M5 4 H19 A2 2 0 0 1 21 6
        V18 A2 2 0 0 1 19 20
        H5 A2 2 0 0 1 3 18
        V6 A2 2 0 0 1 5 4 Z
        M7 9 L10 12 L7 15
        M12 15 H17
    </StreamGeometry>

    <StreamGeometry x:Key="SidebarReportsIcon">
        M6 3 H14 L19 8 V20
        A1 1 0 0 1 18 21
        H6 A1 1 0 0 1 5 20
        V4 A1 1 0 0 1 6 3 Z
        M14 3 V8 H19
        M9 17 V14
        M12 17 V11
        M15 17 V13
    </StreamGeometry>

    <!-- Symmetric eight-tooth settings gear. -->

    <StreamGeometry x:Key="SidebarSettingsIcon">
        M19.5 9.6
        L22.0 9.9
        L22.0 14.1
        L19.5 14.4
        L19.0 15.6
        L20.6 17.6
        L17.6 20.6
        L15.6 19.0
        L14.4 19.5
        L14.1 22.0
        L9.9 22.0
        L9.6 19.5
        L8.4 19.0
        L6.4 20.6
        L3.4 17.6
        L5.0 15.6
        L4.5 14.4
        L2.0 14.1
        L2.0 9.9
        L4.5 9.6
        L5.0 8.4
        L3.4 6.4
        L6.4 3.4
        L8.4 5.0
        L9.6 4.5
        L9.9 2.0
        L14.1 2.0
        L14.4 4.5
        L15.6 5.0
        L17.6 3.4
        L20.6 6.4
        L19.0 8.4
        Z
        M14.5 12
        A2.5 2.5 0 1 1 9.5 12
        A2.5 2.5 0 1 1 14.5 12
    </StreamGeometry>

</ResourceDictionary>
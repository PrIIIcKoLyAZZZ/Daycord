<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Sidebar navigation buttons -->

    <Style Selector="Button.sidebar-nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3,0,0,0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="10,11"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="42"/>
    </Style>

    <!-- Hover -->

    <Style Selector="Button.sidebar-nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Background}"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>

    <!-- Selected -->

    <Style Selector="Button.sidebar-nav.active">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.sidebar-nav.active /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Selected + Hover -->

    <Style Selector="Button.sidebar-nav.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedHoverBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Selected + Pressed -->

    <Style Selector="Button.sidebar-nav.active:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SidebarSelectedHoverBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Keyboard focus -->

    <Style Selector="Button.sidebar-nav:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
    </Style>

    <!-- Shared navigation icon appearance -->

    <Style Selector="Path.sidebar-icon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke"
                Value="{Binding Foreground, RelativeSource={RelativeSource FindAncestor, AncestorType=Button}}"/>
        <Setter Property="StrokeThickness" Value="1.8"/>
        <Setter Property="StrokeLineCap" Value="Round"/>
        <Setter Property="StrokeJoin" Value="Round"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
    </Style>

    <!-- Bounce: all navigation icons, including Settings -->

    <Style Selector="Button.sidebar-nav.active Path.sidebar-icon">
        <Style.Animations>
            <Animation Duration="0:0:0.28"
                       IterationCount="1"
                       Easing="QuadraticEaseOut"
                       FillMode="None">

                <KeyFrame Cue="0%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>

                <KeyFrame Cue="36%">
                    <Setter Property="TranslateTransform.Y" Value="-4"/>
                </KeyFrame>

                <KeyFrame Cue="68%">
                    <Setter Property="TranslateTransform.Y" Value="1"/>
                </KeyFrame>

                <KeyFrame Cue="100%">
                    <Setter Property="TranslateTransform.Y" Value="0"/>
                </KeyFrame>

            </Animation>
        </Style.Animations>
    </Style>

    <!--
        Settings gear rotation.

        The eight-tooth gear rotates clockwise by 90 degrees,
        which is equivalent to exactly two teeth.

        Duration: 420 ms
        Rotation: 0 -> 90 degrees
        Iterations: 1

        The gear is rotationally symmetric after 90 degrees.
        FillMode=None restores the transform to zero degrees
        without a visible orientation change.
    -->

    <Style Selector="Button.sidebar-nav.active Path.sidebar-icon.settings-gear">
        <Style.Animations>
            <Animation Duration="0:0:0.42"
                       IterationCount="1"
                       Easing="CubicEaseOut"
                       FillMode="None">

                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0"/>
                </KeyFrame>

                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="90"/>
                </KeyFrame>

            </Animation>
        </Style.Animations>
    </Style>

</Styles>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daycord.Desktop.ViewModels"
             xmlns:views="using:Daycord.Desktop.Views"
             x:Class="Daycord.Desktop.Views.TaskDetailsView"
             x:DataType="vm:TaskDetailsViewModel"
             Background="{DynamicResource Background}">

    <UserControl.Styles>
        <Style Selector="TextBox.details-input">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBox.details-input:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <Style Selector="TextBox.details-input.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <Style Selector="ComboBox.details-status">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button.details-action, Button.details-tab">
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Background}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button.details-tab.active">
            <Setter Property="Background" Value="{DynamicResource SidebarSelectedBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
        </Style>

        <Style Selector="Button.details-primary">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource Background}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Border.work-entry-row">
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="0,8"/>
        </Style>

        <Style Selector="Button.details-calendar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </UserControl.Styles>

    <!-- Root grid: all confirmation overlays cover the full viewport. -->
    <Grid>

        <Grid RowDefinitions="Auto,*,Auto"
              Margin="20,18,20,22"
              RowSpacing="12"
              MaxWidth="980"
              HorizontalAlignment="Stretch">

            <!-- Header -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="8">

                <StackPanel Grid.Column="0" Spacing="5">
                    <TextBlock Text="{Binding Heading}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontFamily="Menlo, Consolas, Courier New"
                               FontSize="11"
                               FontWeight="SemiBold"/>

                    <Button Classes="details-action"
                            HorizontalAlignment="Left"
                            Content="{Binding BackLabel}"
                            Command="{Binding BackCommand}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Classes="details-primary"
                        VerticalAlignment="Bottom"
                        Content="{Binding SaveButtonText}"
                        Command="{Binding SaveCommand}"/>
            </Grid>

            <!-- Scrollable content -->
            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">

                <StackPanel Spacing="15" Margin="0,4,4,6">

                    <ProgressBar Height="2"
                                 IsIndeterminate="True"
                                 IsVisible="{Binding IsLoading}"
                                 Foreground="{DynamicResource Accent}"/>

                    <TextBlock IsVisible="{Binding IsLoading}"
                               Text="{Binding LoadingMessage}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"/>

                    <TextBlock IsVisible="{Binding IsTaskNotFound}"
                               Text="{Binding NotFoundMessage}"
                               Foreground="{DynamicResource Accent}"
                               TextWrapping="Wrap"/>

                    <TextBlock IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource Accent}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Spacing="15"
                                IsVisible="{Binding IsLoaded}">

                        <!-- Number and title -->
                        <Grid ColumnDefinitions="*,2*"
                              ColumnSpacing="12">

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding NumberLabel}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="11"/>

                                <TextBox Classes="details-input"
                                         Text="{Binding TaskNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding TitleLabel}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="11"/>

                                <TextBox x:Name="TitleInput"
                                         Classes="details-input"
                                         Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanEdit}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Task date and status -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="12">

                            <StackPanel Grid.Column="0" Spacing="6">
                                <TextBlock Text="{Binding DateLabel}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="11"/>

                                <Grid x:Name="DateSegment"
                                      ColumnDefinitions="*,Auto,Auto">

                                    <Border Grid.ColumnSpan="3"
                                            Background="{DynamicResource Surface}"
                                            BorderBrush="{DynamicResource Background}"
                                            BorderThickness="1"
                                            CornerRadius="6"/>

                                    <TextBox Grid.Column="0"
                                             Classes="details-input"
                                             Classes.invalid="{Binding IsDateInputInvalid}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Text="{Binding DateInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="{Binding DatePlaceholder}"
                                             IsEnabled="{Binding CanEdit}"
                                             AcceptsReturn="False"
                                             KeyDown="OnDateKeyDown"/>

                                    <Button Grid.Column="1"
                                            Classes="details-calendar"
                                            IsEnabled="{Binding CanEdit}"
                                            Content="×"
                                            Click="OnClearDateClick"/>

                                    <Button Grid.Column="2"
                                            Classes="details-calendar"
                                            IsEnabled="{Binding CanEdit}"
                                            Click="OnCalendarButtonClick">

                                        <Path Width="17" Height="17"
                                              Stretch="Uniform"
                                              Stroke="{DynamicResource Accent}"
                                              StrokeThickness="1.6"
                                              StrokeLineCap="Round"
                                              Data="M3,5 L17,5 L17,18 L3,18 Z M6.5,2 L6.5,8 M13.5,2 L13.5,8 M3,9 L17,9"/>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="6">
                                <TextBlock Text="{Binding StatusLabel}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="11"/>

                                <ComboBox Classes="details-status"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding SelectedStatus, Mode=TwoWay}"
                                          IsEnabled="{Binding CanEdit}"
                                          HorizontalAlignment="Stretch">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:TaskDetailsStatusOption">
                                            <TextBlock Text="{Binding Label}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Planned duration in Create mode -->
                        <StackPanel Spacing="6"
                                    IsVisible="{Binding IsCreateMode}">

                            <TextBlock Text="{Binding PlannedTimeLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11"/>

                            <TextBox Classes="details-input"
                                     Width="190"
                                     HorizontalAlignment="Left"
                                     Text="{Binding PlannedTimeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="{Binding PlannedTimePlaceholder}"
                                     ToolTip.Tip="{Binding PlannedTimeHint}"
                                     IsEnabled="{Binding CanEditPlannedTime}"
                                     AcceptsReturn="False"/>
                        </StackPanel>

                        <!-- Planning Periods: unchanged independent section -->
                        <Border IsVisible="{Binding !IsCreateMode}"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Background}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <TextBlock Text="{Binding PeriodsLabel}"
                                               Foreground="{DynamicResource PrimaryText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding TotalPlannedLabel}"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="11"/>

                                        <TextBlock Text="{Binding TotalPlannedText}"
                                                   Foreground="{DynamicResource Accent}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Background="{DynamicResource SecondaryText}"
                                        Opacity="0.2"/>

                                <TextBlock IsVisible="{Binding HasNoPlanningPeriods}"
                                           Text="{Binding TotalPlannedText}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="12"/>

                                <ItemsControl IsVisible="{Binding HasPlanningPeriods}"
                                              ItemsSource="{Binding PlanningPeriods}">

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PlanningPeriodRowViewModel">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                                                  ColumnSpacing="10"
                                                  Margin="0,3">

                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding DateText}"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DurationText}"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           FontSize="12"
                                                           MinWidth="64"
                                                           VerticalAlignment="Center"/>

                                                <Button Grid.Column="2"
                                                        Classes="details-action"
                                                        Content="✎"
                                                        Padding="9,5"
                                                        MinHeight="30"
                                                        Command="{Binding EditCommand}"/>

                                                <Button Grid.Column="3"
                                                        Classes="details-action"
                                                        Content="×"
                                                        Padding="9,5"
                                                        MinHeight="30"
                                                        Command="{Binding DeleteCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Classes="details-action"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !IsPeriodEditorOpen}"
                                        IsEnabled="{Binding CanManagePlanningPeriods}"
                                        Content="{Binding AddPeriodLabel}"
                                        Command="{Binding AddPeriodCommand}"/>

                                <Border IsVisible="{Binding IsPeriodEditorOpen}"
                                        Background="{DynamicResource Background}"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">

                                    <StackPanel Spacing="10">
                                        <TextBlock Text="{Binding PeriodEditorHeading}"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">

                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Text="{Binding PeriodDateLabel}"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           FontSize="11"/>

                                                <Grid x:Name="PeriodDateSegment"
                                                      ColumnDefinitions="*,Auto">

                                                    <Border Grid.ColumnSpan="2"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="6"/>

                                                    <TextBox Grid.Column="0"
                                                             Classes="details-input"
                                                             Classes.invalid="{Binding IsPeriodDateInputInvalid}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Text="{Binding PeriodDateInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CanSavePeriod}"
                                                             AcceptsReturn="False"
                                                             KeyDown="OnPeriodDateKeyDown"/>

                                                    <Button Grid.Column="1"
                                                            Classes="details-calendar"
                                                            IsEnabled="{Binding CanSavePeriod}"
                                                            Click="OnPeriodCalendarButtonClick">

                                                        <Path Width="17" Height="17"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource Accent}"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round"
                                                              Data="M3,5 L17,5 L17,18 L3,18 Z M6.5,2 L6.5,8 M13.5,2 L13.5,8 M3,9 L17,9"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{Binding PeriodDurationLabel}"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           FontSize="11"/>

                                                <TextBox Classes="details-input"
                                                         Text="{Binding PeriodDurationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="{Binding PlannedTimePlaceholder}"
                                                         ToolTip.Tip="{Binding PlannedTimeHint}"
                                                         IsEnabled="{Binding CanSavePeriod}"
                                                         AcceptsReturn="False"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8">

                                            <Button Classes="details-action"
                                                    Content="{Binding CancelLabel}"
                                                    Command="{Binding CancelPeriodCommand}"/>

                                            <Button Classes="details-primary"
                                                    Content="{Binding SavePeriodLabel}"
                                                    Command="{Binding SavePeriodCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- DC-010: Actual Time / Work Log -->
                        <Border IsVisible="{Binding !IsCreateMode}"
                                Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource Background}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="14">

                            <StackPanel Spacing="12">

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="10">

                                    <TextBlock Text="{Binding WorkLogLabel}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryText}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                VerticalAlignment="Center">

                                        <TextBlock Text="{Binding TotalActualLabel}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryText}"/>

                                        <TextBlock Text="{Binding TotalActualText}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"/>
                                    </StackPanel>
                                </Grid>

                                <Border Height="1"
                                        Background="{DynamicResource SecondaryText}"
                                        Opacity="0.2"/>

                                <TextBlock IsVisible="{Binding HasNoWorkEntries}"
                                           Text="{Binding NoWorkEntriesLabel}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="12"/>

                                <!-- Persisted entries -->
                                <StackPanel IsVisible="{Binding HasWorkEntries}"
                                            Spacing="7">

                                    <TextBlock Text="{Binding WorkEntriesLabel}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryText}"/>

                                    <ItemsControl ItemsSource="{Binding WorkEntries}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkEntryRowViewModel">

                                                <Border Classes="work-entry-row">
                                                    <StackPanel Spacing="5">

                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto"
                                                              ColumnSpacing="10">

                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding DateText}"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       VerticalAlignment="Center"/>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DurationText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource Accent}"
                                                                       VerticalAlignment="Center"/>

                                                            <Button Grid.Column="3"
                                                                    Classes="details-action"
                                                                    Content="✎"
                                                                    MinHeight="30"
                                                                    Padding="9,5"
                                                                    Command="{Binding EditCommand}"/>

                                                            <Button Grid.Column="4"
                                                                    Classes="details-action"
                                                                    Content="×"
                                                                    MinHeight="30"
                                                                    Padding="9,5"
                                                                    Command="{Binding DeleteCommand}"/>
                                                        </Grid>

                                                        <TextBlock IsVisible="{Binding HasDescription}"
                                                                   Text="{Binding DescriptionPreview}"
                                                                   ToolTip.Tip="{Binding WorkDescription}"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="12"/>

                                                        <TextBlock IsVisible="{Binding HasNote}"
                                                                   Text="{Binding NotePreview}"
                                                                   ToolTip.Tip="{Binding Note}"
                                                                   Foreground="{DynamicResource SecondaryText}"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Button Classes="details-action"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding !IsWorkEntryEditorOpen}"
                                        IsEnabled="{Binding CanManageWorkEntries}"
                                        Content="{Binding AddWorkEntryLabel}"
                                        Command="{Binding AddWorkEntryCommand}"/>

                                <!-- Separate WorkEntry editor -->
                                <Border IsVisible="{Binding IsWorkEntryEditorOpen}"
                                        Background="{DynamicResource Background}"
                                        BorderBrush="{DynamicResource Accent}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="12">

                                    <StackPanel Spacing="10">

                                        <TextBlock Text="{Binding WorkEditorHeading}"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   FontWeight="SemiBold"
                                                   FontSize="12"/>

                                        <Grid ColumnDefinitions="*,*"
                                              ColumnSpacing="10">

                                            <!-- Work date -->
                                            <StackPanel Grid.Column="0" Spacing="5">
                                                <TextBlock Text="{Binding WorkDateLabel}"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           FontSize="11"/>

                                                <Grid x:Name="WorkDateSegment"
                                                      ColumnDefinitions="*,Auto">

                                                    <Border Grid.ColumnSpan="2"
                                                            Background="{DynamicResource Surface}"
                                                            CornerRadius="6"/>

                                                    <TextBox Grid.Column="0"
                                                             Classes="details-input"
                                                             Classes.invalid="{Binding IsWorkDateInputInvalid}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             Text="{Binding WorkDateInputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding CanSaveWorkEntry}"
                                                             AcceptsReturn="False"
                                                             KeyDown="OnWorkDateKeyDown"/>

                                                    <Button Grid.Column="1"
                                                            Classes="details-calendar"
                                                            IsEnabled="{Binding CanSaveWorkEntry}"
                                                            Click="OnWorkCalendarButtonClick">

                                                        <Path Width="17" Height="17"
                                                              Stretch="Uniform"
                                                              Stroke="{DynamicResource Accent}"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round"
                                                              Data="M3,5 L17,5 L17,18 L3,18 Z M6.5,2 L6.5,8 M13.5,2 L13.5,8 M3,9 L17,9"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Actual duration -->
                                            <StackPanel Grid.Column="1" Spacing="5">
                                                <TextBlock Text="{Binding WorkDurationLabel}"
                                                           Foreground="{DynamicResource SecondaryText}"
                                                           FontSize="11"/>

                                                <TextBox Classes="details-input"
                                                         Text="{Binding WorkDurationInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         PlaceholderText="{Binding PlannedTimePlaceholder}"
                                                         ToolTip.Tip="{Binding PlannedTimeHint}"
                                                         IsEnabled="{Binding CanSaveWorkEntry}"
                                                         AcceptsReturn="False"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Work description -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding WorkDescriptionLabel}"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       FontSize="11"/>

                                            <TextBox Classes="details-input"
                                                     Text="{Binding WorkDescriptionInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="75"
                                                     MaxHeight="190"
                                                     IsEnabled="{Binding CanSaveWorkEntry}"/>
                                        </StackPanel>

                                        <!-- Optional note -->
                                        <StackPanel Spacing="5">
                                            <TextBlock Text="{Binding WorkNoteLabel}"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       FontSize="11"/>

                                            <TextBox Classes="details-input"
                                                     Text="{Binding WorkNoteInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="38"
                                                     MaxHeight="110"
                                                     IsEnabled="{Binding CanSaveWorkEntry}"/>
                                        </StackPanel>

                                        <TextBlock Text="{Binding WorkEntrySaveHint}"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"/>

                                        <StackPanel Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    Spacing="8">

                                            <Button Classes="details-action"
                                                    Content="{Binding CancelLabel}"
                                                    Command="{Binding CancelWorkEntryCommand}"/>

                                            <Button Classes="details-primary"
                                                    Content="{Binding SaveWorkEntryLabel}"
                                                    Command="{Binding SaveWorkEntryCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Short description -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding ShortDescriptionLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="11"/>

                            <TextBox Classes="details-input"
                                     Text="{Binding ShortDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="66"
                                     MaxHeight="150"
                                     IsEnabled="{Binding CanEdit}"/>
                        </StackPanel>

                        <!-- Markdown -->
                        <StackPanel Spacing="9">

                            <TextBlock Text="{Binding MarkdownLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontFamily="Menlo, Consolas, Courier New"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>

                            <Border Height="1"
                                    Background="{DynamicResource SecondaryText}"
                                    Opacity="0.25"/>

                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Button Classes="details-tab"
                                        Classes.active="{Binding IsEditMode}"
                                        Content="{Binding EditLabel}"
                                        Command="{Binding ShowEditCommand}"/>

                                <Button Classes="details-tab"
                                        Classes.active="{Binding IsPreviewMode}"
                                        Content="{Binding PreviewLabel}"
                                        Command="{Binding ShowPreviewCommand}"/>
                            </StackPanel>

                            <TextBox IsVisible="{Binding IsEditMode}"
                                     Classes="details-input"
                                     Text="{Binding DescriptionMarkdown, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="Menlo, Consolas, Courier New"
                                     FontSize="12"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="260"
                                     MaxHeight="440"
                                     IsEnabled="{Binding CanEdit}"/>

                            <Border IsVisible="{Binding IsPreviewMode}"
                                    Background="{DynamicResource Surface}"
                                    CornerRadius="6"
                                    Padding="14"
                                    MinHeight="260">

                                <ScrollViewer MaxHeight="425"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">

                                    <StackPanel x:Name="PreviewBlocks" Spacing="9"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Grid Grid.Row="2"
                  ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="12">

                <Button Grid.Column="0"
                        Classes="details-action"
                        Content="{Binding CancelLabel}"
                        Command="{Binding CancelCommand}"/>

                <TextBlock Grid.Column="1"
                           IsVisible="{Binding IsSaveSuccessful}"
                           Text="{Binding SavedMessage}"
                           Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center"
                           FontSize="12"/>

                <ProgressBar Grid.Column="2"
                             Width="70"
                             Height="2"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsSaving}"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource Accent}"/>
            </Grid>
        </Grid>

        <!-- Unsaved changes dialog -->
        <Grid ZIndex="20"
              IsVisible="{Binding IsDiscardConfirmationOpen}">

            <Border Background="#AA000000"/>

            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="420"
                    Margin="12"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DiscardConfirmationTitle}"
                               Foreground="{DynamicResource PrimaryText}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding DiscardConfirmationMessage}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">

                        <Button Classes="details-action"
                                Content="{Binding KeepEditingLabel}"
                                Command="{Binding KeepEditingCommand}"/>

                        <Button Classes="details-primary"
                                Content="{Binding DiscardLabel}"
                                Command="{Binding ConfirmDiscardCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Delete PlanningPeriod overlay -->
        <Grid ZIndex="18"
              IsVisible="{Binding IsDeletePeriodConfirmationOpen}">

            <Border Background="#AA000000"/>

            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="420"
                    Margin="12"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DeletePeriodTitle}"
                               Foreground="{DynamicResource PrimaryText}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding DeletePeriodMessage}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">

                        <Button Classes="details-action"
                                Content="{Binding CancelLabel}"
                                Command="{Binding CancelDeletePeriodCommand}"/>

                        <Button Classes="details-primary"
                                Content="{Binding DeletePeriodLabel}"
                                Command="{Binding ConfirmDeletePeriodCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- DC-010: Root-level WorkEntry delete confirmation -->
        <Grid ZIndex="19"
              IsVisible="{Binding IsDeleteWorkEntryConfirmationOpen}">

            <Border Background="#AA000000"/>

            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Accent}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MaxWidth="420"
                    Margin="12"
                    Padding="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding DeleteWorkEntryTitle}"
                               Foreground="{DynamicResource PrimaryText}"
                               FontWeight="SemiBold"
                               FontSize="15"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding DeleteWorkEntryMessage}"
                               Foreground="{DynamicResource SecondaryText}"
                               FontSize="12"
                               TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">

                        <Button Classes="details-action"
                                Content="{Binding CancelLabel}"
                                Command="{Binding CancelDeleteWorkEntryCommand}"/>

                        <Button Classes="details-primary"
                                Content="{Binding DeleteWorkEntryLabel}"
                                Command="{Binding ConfirmDeleteWorkEntryCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- One shared calendar for all three date targets -->
        <views:DaycordCalendarView x:Name="SharedCalendar"/>
    </Grid>
</UserControl>
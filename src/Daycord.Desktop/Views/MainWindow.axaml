<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daycord.Desktop.ViewModels"
        xmlns:views="using:Daycord.Desktop.Views"
        x:Class="Daycord.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding AppName}"
        Width="1080"
        Height="720"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}">

    <!-- ViewModel to View mapping -->

    <Window.DataTemplates>
        <DataTemplate DataType="vm:PlaceholderPageViewModel"
                      x:DataType="vm:PlaceholderPageViewModel">
            <views:PlaceholderPageView/>
        </DataTemplate>

        <DataTemplate DataType="vm:TerminalViewModel"
                      x:DataType="vm:TerminalViewModel">
            <views:TerminalView/>
        </DataTemplate>

        <DataTemplate DataType="vm:TaskListViewModel"
                      x:DataType="vm:TaskListViewModel">
            <views:TaskListView/>
        </DataTemplate>

        <DataTemplate DataType="vm:HomeDashboardViewModel"
                      x:DataType="vm:HomeDashboardViewModel">
            <views:HomeDashboardView/>
        </DataTemplate>

        <DataTemplate DataType="vm:CalendarPageViewModel"
                      x:DataType="vm:CalendarPageViewModel">
            <views:CalendarPageView/>
        </DataTemplate>

        <!-- Monthly Excel Reports (DC-013) -->

        <DataTemplate DataType="vm:ReportsViewModel"
                      x:DataType="vm:ReportsViewModel">
            <views:ReportsView/>
        </DataTemplate>

        <DataTemplate DataType="vm:TaskDetailsViewModel"
                      x:DataType="vm:TaskDetailsViewModel">
            <views:TaskDetailsView/>
        </DataTemplate>
    </Window.DataTemplates>

    <!-- Sidebar resources and styles (DC-018) -->

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Daycord.Desktop/Themes/NavigationIcons.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <StyleInclude Source="avares://Daycord.Desktop/Styles/Sidebar.axaml"/>
    </Window.Styles>

    <!-- Root layout -->

    <Grid Background="{DynamicResource Background}">

        <!-- Database initialization -->

        <Border IsVisible="{Binding IsDatabaseInitializing}"
                Background="{DynamicResource Background}"
                Padding="32">

            <Border Background="{DynamicResource Surface}"
                    CornerRadius="14"
                    Padding="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="520">

                <StackPanel Spacing="18">
                    <Border Width="48"
                            Height="4"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}"/>

                    <TextBlock Text="{Binding AppWordmark}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock Text="{Binding WelcomeMessage}"
                               FontSize="18"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="3"
                                 MinWidth="220"
                                 Foreground="{DynamicResource Accent}"/>

                    <TextBlock Text="{Binding DatabaseStatusMessage}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryText}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Database initialization error -->

        <Border IsVisible="{Binding IsDatabaseFailed}"
                Background="{DynamicResource Background}"
                Padding="32">

            <Border Background="{DynamicResource Surface}"
                    CornerRadius="14"
                    Padding="36"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MaxWidth="600">

                <StackPanel Spacing="18">
                    <Border Width="48"
                            Height="4"
                            CornerRadius="2"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource Accent}"/>

                    <TextBlock Text="{Binding AppWordmark}"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock Text="{Binding DatabaseStatusMessage}"
                               FontSize="14"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryText}"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Main application shell -->

        <Grid IsVisible="{Binding IsDatabaseReady}"
              ColumnDefinitions="200,*">

            <!-- Sidebar -->

            <Border Grid.Column="0"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Background}"
                    BorderThickness="0,0,1,0">

                <Grid Margin="16,24,16,20"
                      RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Brand -->

                    <Grid Grid.Row="0"
                          Margin="12,0,0,36"
                          ColumnDefinitions="Auto"
                          RowDefinitions="Auto,Auto"
                          HorizontalAlignment="Left">

                        <Border Grid.Row="0"
                                Height="3"
                                Margin="0,0,0,10"
                                CornerRadius="2"
                                HorizontalAlignment="Stretch"
                                Background="{DynamicResource Accent}"/>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding AppWordmark}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   LetterSpacing="1"
                                   Foreground="{DynamicResource PrimaryText}"/>
                    </Grid>

                    <!-- Navigation heading -->

                    <TextBlock Grid.Row="1"
                               Margin="14,0,0,14"
                               Text="{Binding NavigationHeading}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <!-- Main navigation -->

                    <StackPanel Grid.Row="2"
                                Spacing="6">

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsHomeSelected}"
                                Command="{Binding NavigateHomeCommand}"
                                AutomationProperties.Name="{Binding NavHomeLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="sidebar-icon"
                                      Data="{StaticResource SidebarHomeIcon}"/>
                                <TextBlock Text="{Binding NavHomeLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsCalendarSelected}"
                                Command="{Binding NavigateCalendarCommand}"
                                AutomationProperties.Name="{Binding NavCalendarLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="sidebar-icon"
                                      Data="{StaticResource SidebarCalendarIcon}"/>
                                <TextBlock Text="{Binding NavCalendarLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsTasksSelected}"
                                Command="{Binding NavigateTasksCommand}"
                                AutomationProperties.Name="{Binding NavTasksLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="sidebar-icon"
                                      Data="{StaticResource SidebarTasksIcon}"/>
                                <TextBlock Text="{Binding NavTasksLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsNewTaskSelected}"
                                Command="{Binding NavigateNewTaskCommand}"
                                AutomationProperties.Name="{Binding NavNewTaskLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="sidebar-icon"
                                      Data="{StaticResource SidebarQuickTaskIcon}"/>
                                <TextBlock Text="{Binding NavNewTaskLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="18"/>

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsReportsSelected}"
                                Command="{Binding NavigateReportsCommand}"
                                AutomationProperties.Name="{Binding NavReportsLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">
                                <Path Classes="sidebar-icon"
                                      Data="{StaticResource SidebarReportsIcon}"/>
                                <TextBlock Text="{Binding NavReportsLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Bottom navigation -->

                    <Border Grid.Row="3"
                            Padding="0,16,0,0"
                            BorderBrush="{DynamicResource Background}"
                            BorderThickness="0,1,0,0">

                        <Button Classes="sidebar-nav"
                                Classes.active="{Binding IsSettingsSelected}"
                                Command="{Binding NavigateSettingsCommand}"
                                AutomationProperties.Name="{Binding NavSettingsLabel}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8"
                                        VerticalAlignment="Center">

                                <!-- Bounce + clockwise gear rotation -->
                                <Path Classes="sidebar-icon settings-gear"
                                      Data="{StaticResource SidebarSettingsIcon}"
                                      RenderTransformOrigin="50%,50%">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="0"/>
                                            <TranslateTransform Y="0"/>
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>

                                <TextBlock Text="{Binding NavSettingsLabel}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>

                </Grid>
            </Border>

            <!-- Main content -->

            <Grid Grid.Column="1"
                  RowDefinitions="Auto,*"
                  Background="{DynamicResource Background}">

                <!-- Page header -->

                <Border Grid.Row="0"
                        Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Background}"
                        BorderThickness="0,0,0,1"
                        Padding="30,24">

                    <TextBlock Text="{Binding CurrentPageTitle}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource PrimaryText}"/>
                </Border>

                <!-- Page content -->

                <Grid Grid.Row="1">
                    <ContentControl IsVisible="{Binding !IsSettingsSelected}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Content="{Binding CurrentPageContent}"/>

                    <!-- DC-015: Settings hosts the existing DC-014 backup UI.
                         The shared page header remains in MainWindow. -->

                    <Border IsVisible="{Binding IsSettingsSelected}">
                        <views:SettingsView x:Name="SettingsPage"
                                            DataContext="{x:Null}"/>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Daycord.Desktop.ViewModels"
             xmlns:models="using:Daycord.Core.Application.Models"
             xmlns:views="using:Daycord.Desktop.Views"
             x:Class="Daycord.Desktop.Views.ReportsView"
             x:DataType="vm:ReportsViewModel"
             Background="{DynamicResource Background}">

    <!-- Custom theme for the four preset action buttons. -->
    <UserControl.Resources>
        <ControlTheme x:Key="ReportsPresetIconTheme"
                      TargetType="Button">

            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      CornerRadius="{TemplateBinding CornerRadius}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </ControlTemplate>
            </Setter>

            <!-- Only highlight on hover. -->
            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background"
                        Value="{DynamicResource SidebarSelectedBackground}"/>
            </Style>

            <!-- Disabled buttons stay transparent, never gray-filled. -->
            <Style Selector="^:disabled">
                <Setter Property="Opacity" Value="0.48"/>
            </Style>

            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush"
                        Value="{DynamicResource SidebarSelectedBackground}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Visible focus for keyboard navigation. -->
            <Style Selector="^:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="BorderBrush"
                        Value="{DynamicResource Accent}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </Style>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>

        <Style Selector="Button.reports-action">
            <Setter Property="Background"
                    Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="MinHeight" Value="37"/>
        </Style>

        <Style Selector="Button.reports-action:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
        </Style>

        <Style Selector="Button.reports-primary">
            <Setter Property="Background"
                    Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Background}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.reports-nav">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Button.reports-nav:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
        </Style>

        <Style Selector="TextBox.reports-input">
            <Setter Property="Background"
                    Value="{DynamicResource Background}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="MinHeight" Value="37"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBox.reports-date">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="Button.reports-calendar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource Accent}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="7"/>
        </Style>

        <Style Selector="Button.reports-calendar:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
        </Style>

        <Style Selector="ComboBox.reports-combo">
            <Setter Property="Background"
                    Value="{DynamicResource Background}"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="MinHeight" Value="39"/>
        </Style>

        <Style Selector="Button.reports-move">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground"
                    Value="{DynamicResource SecondaryText}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="Width" Value="29"/>
            <Setter Property="Height" Value="29"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style Selector="Button.reports-move:pointerover">
            <Setter Property="Background"
                    Value="{DynamicResource SidebarSelectedBackground}"/>
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer x:Name="ReportsScroll"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="22,20,22,28">

                <!-- MAIN REPORT PAGE -->

                <StackPanel x:Name="MainReportPage"
                            MaxWidth="900"
                            Spacing="17">

                    <!-- Reporting period -->

                    <Border Background="{DynamicResource Surface}"
                            CornerRadius="10"
                            Padding="16">

                        <StackPanel Spacing="14">

                            <TextBlock Text="{Binding ReportingPeriodLabel}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="12"
                                  IsEnabled="{Binding !IsExporting}">

                                <!-- From date -->

                                <StackPanel Grid.Column="0" Spacing="6">

                                    <TextBlock Text="{Binding UiLabels.DateFrom}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="11"/>

                                    <Border Background="{DynamicResource Background}"
                                            BorderBrush="{DynamicResource SidebarSelectedBackground}"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                        <Grid x:Name="ReportFromSegment"
                                              ColumnDefinitions="*,Auto">

                                            <TextBox x:Name="ReportFromInput"
                                                     Grid.Column="0"
                                                     Classes="reports-date"
                                                     PlaceholderText="dd.MM.yyyy"
                                                     LostFocus="OnDateInputLostFocus"
                                                     KeyDown="OnDateInputKeyDown"/>

                                            <Button Grid.Column="1"
                                                    Classes="reports-calendar"
                                                    ToolTip.Tip="{Binding UiLabels.DateFrom}"
                                                    Click="OnFromCalendarClick">

                                                <Path Width="18"
                                                      Height="18"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource Accent}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineCap="Round"
                                                      Data="M3,5 L17,5 L17,18 L3,18 Z M6.5,2 L6.5,8 M13.5,2 L13.5,8 M3,9 L17,9"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- To date -->

                                <StackPanel Grid.Column="1" Spacing="6">

                                    <TextBlock Text="{Binding UiLabels.DateTo}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               FontSize="11"/>

                                    <Border Background="{DynamicResource Background}"
                                            BorderBrush="{DynamicResource SidebarSelectedBackground}"
                                            BorderThickness="1"
                                            CornerRadius="7">

                                        <Grid x:Name="ReportToSegment"
                                              ColumnDefinitions="*,Auto">

                                            <TextBox x:Name="ReportToInput"
                                                     Grid.Column="0"
                                                     Classes="reports-date"
                                                     PlaceholderText="dd.MM.yyyy"
                                                     LostFocus="OnDateInputLostFocus"
                                                     KeyDown="OnDateInputKeyDown"/>

                                            <Button Grid.Column="1"
                                                    Classes="reports-calendar"
                                                    ToolTip.Tip="{Binding UiLabels.DateTo}"
                                                    Click="OnToCalendarClick">

                                                <Path Width="18"
                                                      Height="18"
                                                      Stretch="Uniform"
                                                      Stroke="{DynamicResource Accent}"
                                                      StrokeThickness="1.6"
                                                      StrokeLineCap="Round"
                                                      Data="M3,5 L17,5 L17,18 L3,18 Z M6.5,2 L6.5,8 M13.5,2 L13.5,8 M3,9 L17,9"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <views:DaycordCalendarView
                                x:Name="ReportCalendar"/>

                            <!-- Month navigation -->

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="8">

                                <Button Grid.Column="0"
                                        Classes="reports-nav"
                                        Command="{Binding PreviousMonthCommand}"
                                        ToolTip.Tip="{Binding PreviousMonthLabel}">

                                    <Path Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          Data="M11,2 L5,8 L11,14"/>
                                </Button>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding MonthTitle}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <Button Grid.Column="2"
                                        Classes="reports-nav"
                                        Command="{Binding NextMonthCommand}"
                                        ToolTip.Tip="{Binding NextMonthLabel}">

                                    <Path Width="15"
                                          Height="15"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          Data="M5,2 L11,8 L5,14"/>
                                </Button>
                            </Grid>

                            <TextBlock IsVisible="{Binding !IsPeriodValid}"
                                       Text="{Binding PeriodErrorMessage}"
                                       Foreground="{DynamicResource Accent}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>

                            <ProgressBar IsVisible="{Binding IsLoading}"
                                         IsIndeterminate="True"
                                         Height="3"
                                         Foreground="{DynamicResource Accent}"/>

                            <TextBlock IsVisible="{Binding IsLoading}"
                                       Text="{Binding LoadingLabel}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <!-- Loading error -->

                    <Border IsVisible="{Binding HasLoadError}"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="14">

                        <StackPanel Spacing="9">

                            <TextBlock Text="{Binding LoadErrorMessage}"
                                       Foreground="{DynamicResource PrimaryText}"
                                       TextWrapping="Wrap"/>

                            <Button Classes="reports-action"
                                    HorizontalAlignment="Left"
                                    Content="{Binding RetryLabel}"
                                    Command="{Binding RetryCommand}"/>
                        </StackPanel>
                    </Border>

                    <!-- Report metrics -->

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="10"
                          IsVisible="{Binding IsLoaded}">

                        <Border Grid.Column="0"
                                Background="{DynamicResource Surface}"
                                CornerRadius="9"
                                Padding="14">

                            <StackPanel Spacing="7">

                                <TextBlock Text="{Binding UiLabels.ReportRows}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock Text="{Binding ReportRowCount}"
                                           FontSize="24"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1"
                                Background="{DynamicResource Surface}"
                                CornerRadius="9"
                                Padding="14">

                            <StackPanel Spacing="7">

                                <TextBlock Text="{Binding TotalPlannedTimeLabel}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock Text="{Binding TotalPlannedTimeText}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource Surface}"
                                CornerRadius="9"
                                Padding="14">

                            <StackPanel Spacing="7">

                                <TextBlock Text="{Binding TotalActualTimeLabel}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBlock Text="{Binding TotalActualTimeText}"
                                           FontSize="23"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border IsVisible="{Binding IsMonthEmpty}"
                            Background="{DynamicResource Surface}"
                            CornerRadius="9"
                            Padding="14">

                        <TextBlock Text="{Binding UiLabels.NoReportRows}"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"/>
                    </Border>

                    <!-- Export actions -->

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12">

                        <Button Grid.Column="0"
                                Classes="reports-primary"
                                Command="{Binding ExportCommand}">

                            <StackPanel Orientation="Horizontal" Spacing="8">

                                <Path Width="16"
                                      Height="16"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Background}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      StrokeJoin="Round"
                                      Data="M12,2 L12,15 M7,10 L12,15 L17,10 M4,17 L4,21 L20,21 L20,17"/>

                                <TextBlock Text="{Binding ExportToExcelLabel}"
                                           IsVisible="{Binding !IsExporting}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding ExportingLabel}"
                                           IsVisible="{Binding IsExporting}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Column="2"
                                Classes="reports-action"
                                IsEnabled="{Binding !IsExporting}"
                                Click="OnOpenSettingsClick">

                            <StackPanel Orientation="Horizontal" Spacing="8">

                                <Path Width="16"
                                      Height="16"
                                      VerticalAlignment="Center"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource PrimaryText}"
                                      StrokeThickness="1.6"
                                      StrokeLineCap="Round"
                                      Data="M3,5 L19,5 M3,11 L19,11 M3,17 L19,17 M8,2 L8,8 M15,8 L15,14 M10,14 L10,20"/>

                                <TextBlock Text="{Binding UiLabels.ExportSettings}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <ProgressBar IsVisible="{Binding IsExporting}"
                                 IsIndeterminate="True"
                                 Height="3"
                                 Foreground="{DynamicResource Accent}"/>

                    <Border IsVisible="{Binding IsExportSuccessful}"
                            Background="{DynamicResource Surface}"
                            CornerRadius="9"
                            Padding="13">

                        <TextBlock Text="{Binding ExportMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border IsVisible="{Binding HasExportError}"
                            Background="{DynamicResource Surface}"
                            BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="13">

                        <TextBlock Text="{Binding ExportMessage}"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryText}"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>

                <!-- EXPORT SETTINGS PAGE -->

                <StackPanel x:Name="ExportSettingsPage"
                            MaxWidth="900"
                            IsVisible="False"
                            Spacing="17">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="14">

                        <Button Grid.Column="0"
                                Classes="reports-action"
                                Content="{Binding UiLabels.BackToReport}"
                                Click="OnBackToReportClick"/>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding UiLabels.ExportSettings}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Preset selection and icon actions -->

                    <Border Background="{DynamicResource Surface}"
                            CornerRadius="10"
                            Padding="16">

                        <StackPanel Spacing="12">

                            <TextBlock Text="{Binding UiLabels.Preset}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto"
                                  ColumnSpacing="6">

                                <ComboBox Grid.Column="0"
                                          Classes="reports-combo"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center"
                                          ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset, Mode=TwoWay}">

                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:WorkReportPreset">
                                            <Grid>
                                                <TextBlock Text="{ReflectionBinding $parent[UserControl].DataContext.UiLabels.DefaultPreset}"
                                                           IsVisible="{Binding IsBuiltIn}"/>

                                                <TextBlock Text="{Binding Name}"
                                                           IsVisible="{Binding !IsBuiltIn}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Create -->

                                <Button Grid.Column="1"
                                        Theme="{StaticResource ReportsPresetIconTheme}"
                                        IsEnabled="{Binding !IsPresetBusy}"
                                        ToolTip.Tip="{Binding UiLabels.CreateNewPreset}"
                                        Click="OnShowCreatePresetClick">

                                    <Path Width="19"
                                          Height="19"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.8"
                                          StrokeLineCap="Round"
                                          Data="M12,3 L12,21 M3,12 L21,12"/>
                                </Button>

                                <!-- Rename -->

                                <Button Grid.Column="2"
                                        Theme="{StaticResource ReportsPresetIconTheme}"
                                        IsEnabled="{Binding CanDeleteSelectedPreset}"
                                        ToolTip.Tip="{Binding UiLabels.RenamePreset}"
                                        Click="OnShowRenamePresetClick">

                                    <Path Width="19"
                                          Height="19"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M4,20 L9,19 L20,8 L16,4 L5,15 Z M14,6 L18,10"/>
                                </Button>

                                <!-- Reset -->

                                <Button Grid.Column="3"
                                        Theme="{StaticResource ReportsPresetIconTheme}"
                                        IsEnabled="{Binding !IsPresetBusy}"
                                        ToolTip.Tip="{Binding UiLabels.ResetToDefault}"
                                        Command="{Binding ResetToDefaultCommand}">

                                    <Path Width="19"
                                          Height="19"
                                          Stretch="Uniform"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M3,3 L3,10 L10,10 M4,10 C5,6 8,4 12,4 C17,4 21,8 21,13 C21,18 17,21 12,21 C8,21 5,19 4,16"/>
                                </Button>

                                <!-- Delete -->

                                <Button Grid.Column="4"
                                        Theme="{StaticResource ReportsPresetIconTheme}"
                                        IsEnabled="{Binding CanDeleteSelectedPreset}"
                                        ToolTip.Tip="{Binding UiLabels.DeletePreset}"
                                        Click="OnDeletePresetClick">

                                    <Path Width="19"
                                          Height="19"
                                          Stretch="Uniform"
                                          Stroke="#D64C4C"
                                          StrokeThickness="1.7"
                                          StrokeLineCap="Round"
                                          StrokeJoin="Round"
                                          Data="M4,6 L20,6 M8,6 L8,4 L16,4 L16,6 M6,6 L7,20 L17,20 L18,6 M10,10 L10,17 M14,10 L14,17"/>
                                </Button>
                            </Grid>

                            <!-- Create preset editor -->

                            <StackPanel x:Name="CreatePresetEditor"
                                        IsVisible="False"
                                        Spacing="9">

                                <TextBox Classes="reports-input"
                                         Text="{Binding NewPresetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="{Binding UiLabels.NewPresetNamePlaceholder}"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">

                                    <Button Classes="reports-primary"
                                            Content="{Binding UiLabels.CreatePreset}"
                                            Command="{Binding CreatePresetCommand}"/>

                                    <Button Classes="reports-action"
                                            Content="{Binding UiLabels.Cancel}"
                                            Click="OnCancelPresetEditClick"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Rename preset editor -->

                            <StackPanel x:Name="RenamePresetEditor"
                                        IsVisible="False"
                                        Spacing="9">

                                <TextBlock Text="{Binding UiLabels.PresetName}"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryText}"/>

                                <TextBox Classes="reports-input"
                                         Text="{Binding PresetNameDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">

                                    <Button Classes="reports-primary"
                                            Content="{Binding UiLabels.SavePresetName}"
                                            Command="{Binding SaveColumnsCommand}"/>

                                    <Button Classes="reports-action"
                                            Content="{Binding UiLabels.Cancel}"
                                            Click="OnCancelPresetEditClick"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock IsVisible="{Binding HasPresetError}"
                                       Text="{Binding PresetErrorMessage}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Column editor -->

                    <Border Background="{DynamicResource Surface}"
                            CornerRadius="10"
                            Padding="16">

                        <StackPanel Spacing="12">

                            <TextBlock Text="{Binding UiLabels.ColumnsAndOrder}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"/>

                            <TextBlock Text="{Binding UiLabels.ColumnsDescription}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <ItemsControl ItemsSource="{Binding ColumnEditors}">

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReportColumnEditorItem">

                                        <Border Background="{DynamicResource Background}"
                                                CornerRadius="7"
                                                Padding="9"
                                                Margin="0,0,0,7">

                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                                  ColumnSpacing="8">

                                                <CheckBox Grid.Column="0"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding IsIncluded, Mode=TwoWay}"/>

                                                <StackPanel Grid.Column="1"
                                                            Spacing="4">

                                                    <TextBlock Text="{Binding DefaultHeader}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryText}"/>

                                                    <TextBox Classes="reports-input"
                                                             MinWidth="100"
                                                             Text="{Binding Header, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </StackPanel>

                                                <Button Grid.Column="2"
                                                        Classes="reports-move"
                                                        Content="↑"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{ReflectionBinding $parent[UserControl].DataContext.UiLabels.MoveUp}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.MoveColumnUpCommand}"
                                                        CommandParameter="{Binding}"/>

                                                <Button Grid.Column="3"
                                                        Classes="reports-move"
                                                        Content="↓"
                                                        VerticalAlignment="Center"
                                                        ToolTip.Tip="{ReflectionBinding $parent[UserControl].DataContext.UiLabels.MoveDown}"
                                                        Command="{ReflectionBinding $parent[UserControl].DataContext.MoveColumnDownCommand}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock IsVisible="{Binding HasUnsavedChanges}"
                                       Text="{Binding UiLabels.UnsavedChanges}"
                                       FontSize="12"
                                       Foreground="{DynamicResource Accent}"/>

                            <Button Classes="reports-primary"
                                    HorizontalAlignment="Left"
                                    Content="{Binding UiLabels.SaveColumnSettings}"
                                    Command="{Binding SaveColumnsCommand}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Delete preset confirmation -->

        <Grid x:Name="DeletePresetConfirmation"
              IsVisible="False"
              Focusable="True"
              KeyDown="OnDeleteConfirmationKeyDown"
              ZIndex="100">

            <Border Background="#AA000000"/>

            <Border Width="440"
                    MaxWidth="440"
                    Margin="18"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource SidebarSelectedBackground}"
                    BorderThickness="1"
                    CornerRadius="10">

                <StackPanel Spacing="16">

                    <TextBlock Text="{Binding UiLabels.DeletePreset}"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"/>

                    <TextBlock x:Name="DeletePresetMessage"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <ProgressBar IsIndeterminate="True"
                                 Height="2"
                                 IsVisible="{Binding IsPresetBusy}"
                                 Foreground="{DynamicResource Accent}"/>

                    <TextBlock Text="{Binding PresetErrorMessage}"
                               IsVisible="{Binding HasPresetError}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource Accent}"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8">

                        <Button x:Name="CancelPresetDeletionButton"
                                Classes="reports-action"
                                Content="{Binding UiLabels.Cancel}"
                                Click="OnCancelDeletePresetClick"/>

                        <Button x:Name="ConfirmPresetDeletionButton"
                                Classes="reports-primary"
                                Content="{Binding UiLabels.DeletePreset}"
                                Click="OnConfirmDeletePresetClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>